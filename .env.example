# Public browser configuration: copy the existing public values from wrangler.jsonc.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional first-party PostHog analytics; blank disables it.
VITE_POSTHOG_KEY=
VITE_POSTHOG_REGION=us
# Optional browser push identity; requires matching private delivery configuration.
VITE_VAPID_PUBLIC_KEY=

# Public Stripe TEST publishable key for an existing balance intent's SCA/card confirmation.
# Never put a secret key here; production activation is a separate approval.
VITE_STRIPE_PUBLISHABLE_KEY=
# Resend sender/contact requested: mackenzie@tryumphgym.com
# Supabase Auth uses SMTP dashboard settings; see docs/launch/RESEND_SETUP.md.

# Server-only contact sender (public address, not a key).
CONTACT_FROM_EMAIL=mackenzie@tryumphgym.com
# Set RESEND_API_KEY only in secure server runtime secrets, never in this file.

# Public Bunny Stream pull-zone hostname from library API settings (no https://).
# Needed for real workout thumbnail images; playback uses separate private token key.
VITE_BUNNY_STREAM_CDN_HOSTNAME=

# Server-only program gates. Approved default: trainer 95% / Tryumph 5% after actual processing fees.
PROGRAM_NATIVE_CHECKOUT_ENABLED=false
PROGRAM_TERMS_OWNER_ID=
# Use a separate Bunny library; verify iframe AND raw CDN protection before true.
BUNNY_PROGRAM_MEDIA_VERIFIED=false
BUNNY_PROGRAM_LIBRARY_ID=
BUNNY_PROGRAM_API_KEY=
BUNNY_PROGRAM_TOKEN_KEY=

# Optional server-only estimates, based on your encoding and provider invoices.
# Blank means unavailable, never an invented rate; separate from the 95/5 split.
PROGRAM_ESTIMATED_GB_PER_HOUR=
PROGRAM_ESTIMATED_USD_PER_GB=
PROGRAM_ESTIMATED_USD_PER_1000_SESSIONS=

# Optional creator memberships: trainer 90% / platform 10% after actual fees.
# Keep disabled until legal review, Connect and signed recurring webhook tests pass.
CREATOR_MEMBERSHIPS_ENABLED=false
CREATOR_PORTAL_CONFIGURATION_ID=
# PROGRAM_TERMS_OWNER_ID above also identifies the sole commercial-approval owner.
# Reviewed private PDF storage + malware/security process must be verified first.
PROGRAM_DOWNLOADS_VERIFIED=false
# Bind COMMUNITY_IMAGES to Cloudflare Images separately, after staging authorization.
COMMUNITY_PHOTOS_VERIFIED=false
COMMUNITY_MODERATION_URL=
# Supply COMMUNITY_MODERATION_KEY through secure server secrets, never public VITE_ settings.
# Initial feed ads support reviewed first-party sponsorships; no automated ad-network billing.
COMMUNITY_FEED_ADS_VERIFIED=false
COMMUNITY_AD_MODE=manual-sponsored
# Supply a random 32+ character COMMUNITY_AD_SESSION_KEY in secure server secrets.
